# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Every value here has a working default in src/config.py, so an empty .env is
# a valid one. The application also starts with no API key at all: /health then
# reports "not_configured", voice falls back to text and the chat answers with a
# stand-in message, which keeps the suite and the health check usable in CI.

LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./runcoach.db

# Gemini, from https://aistudio.google.com/apikey
# Paste the key exactly as issued. Google has used more than one key format, so
# do not judge a key by its prefix: check it with GET /health, which reports
# "configured" once the application can actually reach the model.
GOOGLE_API_KEY=

# Model ids live in configuration because they get retired: gemini-2.5-flash
# was withdrawn for new accounts mid-project. Overriding these should never
# require a deploy.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Profile extraction (F4) is a second request on the turns that carry profile
# data. It deliberately runs on a different model id from the replies, because
# rate limits are per model and this way the two do not compete: measured on the
# free tier, the coaching model peaked at 22 requests a minute against a ceiling
# of 15 while this one sat at 1.
# GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite
#
# Set this to false to stop extracting profiles. Costs personalisation, buys
# back the second request on every qualifying turn.
# PROFILE_EXTRACTION_ENABLED=

# Reading the week back out of the coach's own reply, to fill the plan panel.
# Its own switch because it is the cheaper of the two extractions to lose: a
# deployment short on daily quota keeps the profile and drops the panel.
PLAN_EXTRACTION_ENABLED=true

# Voice budget per session, in seconds. Audio spends far more tokens per minute
# than text, so one long conversation could otherwise leave the next visitor
# with a mute demo.
# VOICE_MAX_SECONDS=300

# Telegram (F6), from @BotFather: /newbot gives you both of these. Without a
# token the bot does not start and reminders are not delivered; everything else
# runs unchanged. The username is only used to build the "Conectar Telegram"
# link, and without it the web client hides that button rather than offering a
# dead address.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Reminders are the one thing a closed tab cannot do, and the only part of the
# system that acts without being asked.
# REMINDERS_ENABLED=true
#
# "Seven in the morning" is a wall clock, and a wall clock needs a place. One
# zone for every runner is a real limitation: the browser knows its own, and
# asking for it is a later fragment.
# REMINDER_TIMEZONE=America/Mexico_City
#
# How long a silence has to last before the coach says something, and how long
# it waits before saying it again.
# INACTIVITY_AFTER_DAYS=3
# INACTIVITY_COOLDOWN_DAYS=7
#
# How often the sweep asks what is due. Lower it to see a reminder sooner while
# testing.
# REMINDER_SWEEP_SECONDS=60

# --- ajuste fino, todos con valores por defecto razonables --------------------

# Cuantos turnos pasados se le vuelven a mostrar al modelo. Acotado porque el
# tier gratuito limita tokens por minuto, y porque los turnos viejos dejan de
# ser utiles.
# HISTORY_LIMIT=20

# Los modelos con razonamiento gastan sus tokens de pensamiento contra este
# presupuesto, asi que tiene que dar margen para los dos.
# GEMINI_MAX_OUTPUT_TOKENS=1200
# GEMINI_TEMPERATURE=0.7

# La extraccion de perfil devuelve cuatro campos: 400 tokens sobran sin invitar
# a una respuesta desbocada.
# GEMINI_EXTRACTION_MAX_OUTPUT_TOKENS=400

# Ninguna espera en el socket de voz puede ser infinita: con audio que el modelo
# no reconoce como habla, ningun turno se completa y un bucle ingenuo se cuelga.
# VOICE_IDLE_TIMEOUT=60

# Quien puede abrir el socket de voz. Los WebSocket no respetan same-origin, asi
# que dejarlo vacio permite que cualquier pagina gaste el presupuesto de la Live
# API. Vacio esta bien en un portatil y mal en un servidor.
# ALLOWED_ORIGINS=https://mi-dominio.example

# Tope de turnos por sesion y minuto. Un turno puede costar dos peticiones de
# las 500 diarias, asi que sin esto un bucle vacia la cuota en minutos y el
# siguiente visitante encuentra un coach que no puede responder. 0 lo desactiva.
# MAX_TURNS_PER_MINUTE=12
