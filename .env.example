# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Every value here has a working default in src/config.py, so an empty .env is
# a valid one. The application also starts with no API key at all: /health then
# reports "not_configured", voice falls back to text and the chat answers with a
# stand-in message, which keeps the suite and the health check usable in CI.

DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./runcoach.db

# Gemini, from https://aistudio.google.com/apikey
# Paste the key exactly as issued. Google has used more than one key format, so
# do not judge a key by its prefix: check it with GET /health, which reports
# "configured" once the application can actually reach the model.
GOOGLE_API_KEY=

# Model ids live in configuration because they get retired: gemini-2.5-flash
# was withdrawn for new accounts mid-project. Overriding these should never
# require a deploy.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Profile extraction (F4) is a second request on the turns that carry profile
# data. It deliberately runs on a different model id from the replies, because
# rate limits are per model and this way the two do not compete: measured on the
# free tier, the coaching model peaked at 22 requests a minute against a ceiling
# of 15 while this one sat at 1.
# GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite
#
# Set this to false to stop extracting profiles. Costs personalisation, buys
# back the second request on every qualifying turn.
# PROFILE_EXTRACTION_ENABLED=true

# Voice budget per session, in seconds. Audio spends far more tokens per minute
# than text, so one long conversation could otherwise leave the next visitor
# with a mute demo.
# VOICE_MAX_SECONDS=300
